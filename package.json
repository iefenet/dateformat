{
  "name": "@iefe/dateformat",
  "version": "2.1.0",
  "description": "轻量零依赖的日期工具：兼容旧版 format 约定，支持中文大写日期、任意日期格式化 formatDate、相对时间 fromNow、日期差值 diff、iOS 兼容解析校验与日期比较，datefmt 命名空间 + Builder 链式调用避免变量污染",
  "repository": { 
    "type": "git", 
    "url": "git+https://github.com/iefenet/dateformat.git" 
  },
  "homepage":"www.iefe.net",
  "type": "module",
  "publishConfig": {
    "access": "public"  
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "www.iefe.net",
  "keywords": [
    "date",
    "date-format",
    "format",
    "chinese-date",
    "中文日期",
    "时间格式化",
    "relative-time",
    "from-now",
    "date-diff",
    "date-utils",
    "framework-agnostic"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {},
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
